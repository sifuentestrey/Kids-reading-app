# ElevenLabs API Key for crystal-clear studio TTS voice for kids reading
ELEVENLABS_API_KEY=

# Optional Google AI Studio key for the natural narrator voice (https://aistudio.google.com/apikey).
# Looks like AIza… and is 39 characters.
#
# Preferred over GEMINI_API_KEY, which is read as a fallback. On Netlify the
# preferred name is required: the AI Gateway claims GEMINI_API_KEY and fills it
# with a gateway JWT, so whatever you set there never reaches Google.
GOOGLE_AI_STUDIO_KEY=
GEMINI_API_KEY=
